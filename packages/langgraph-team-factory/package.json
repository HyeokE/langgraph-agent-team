{
  "name": "@agent-team/langgraph-team-factory",
  "version": "0.1.0",
  "description": "Factory-pattern toolkit for building LangGraph agent teams in TypeScript.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "author": "agent-team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/agent-team/langgraph-team-factory.git"
  },
  "bugs": {
    "url": "https://github.com/agent-team/langgraph-team-factory/issues"
  },
  "homepage": "https://github.com/agent-team/langgraph-team-factory#readme",
  "scripts": {
    "build": "tsup src/index.ts src/types/index.ts --format esm --dts --sourcemap --clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run --coverage",
    "test:c8": "c8 --check-coverage --lines 80 --functions 80 --statements 80 --branches 70 pnpm run test",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@langchain/langgraph": "latest",
    "zod": "^3.24.2"
  }
}
