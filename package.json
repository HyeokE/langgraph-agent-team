{
  "name": "agent-team",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:c8": "pnpm -r test:c8",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "clean": "pnpm -r clean",
    "example:supervisor": "pnpm --filter @agent-team/langgraph-team-factory build && node examples/supervisor-routing/index.mjs",
    "example:tool": "pnpm --filter @agent-team/langgraph-team-factory build && node examples/tool-enabled-agent/index.mjs",
    "example:declarative": "pnpm --filter @agent-team/langgraph-team-factory build && node examples/declarative-team/index.mjs",
    "app:dev": "pnpm --filter @agent-team/electron-app dev",
    "app:build": "pnpm --filter @agent-team/electron-app build",
    "app:package": "pnpm --filter @agent-team/electron-app package"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/node": "^22.13.5",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "@agent-team/langgraph-team-factory": "workspace:*",
    "eslint": "^9.21.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6",
    "c8": "^10.1.3",
    "@vitest/coverage-v8": "^3.0.6",
    "zod": "^3.24.2"
  }
}
